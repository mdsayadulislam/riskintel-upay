# RiskIntel upay - Backend Environment Variables
# Copy to .env and configure for your environment.

# Environment mode: 'development', 'staging', 'production'
RISKINTEL_ENV=development

# JWT Secret Key (CRITICAL: In production, generate with `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://riskintel-upay.vercel.app

# Rate Limiting (requests per minute)
RATE_LIMIT_ASSESS_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_2FA_PER_MIN=10
RATE_LIMIT_RECOVERY_PER_MIN=5

# Database Persistence Path
DATABASE_PATH=data/riskintel_audit.db

# 2FA and Recovery Security
TWO_FACTOR_EXPIRY_SECONDS=300
TWO_FACTOR_MAX_ATTEMPTS=3
RECOVERY_TOKEN_EXPIRY_SECONDS=900

